# --- Elasticsearch: pick ONE of these ---
# 1) Elastic Cloud Serverless (or any cluster with an endpoint URL + API key):
#    ELASTIC_URL=https://my-project.es.us-east-1.aws.elastic.cloud:443
#    ELASTIC_API_KEY=...
# 2) Classic Elastic Cloud deployment. The Cloud ID looks like
#    "name:dXMtZWFzdC0x..." (not a URL):
#    ELASTIC_CLOUD_ID=...
#    ELASTIC_API_KEY=...
# 3) Local / self-managed. From Docker, a cluster on your own machine is
#    host.docker.internal, not localhost:
#    ELASTIC_URL=http://host.docker.internal:9200
#    ELASTIC_USERNAME=elastic   (optional)
#    ELASTIC_PASSWORD=          (optional)
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_CLOUD_ID=

# --- LLM for the agent orchestrator ---
# "bedrock" (default -- uses AWS, a hackathon sponsor) or "anthropic"
# (direct Anthropic API, e.g. local dev fallback).
LLM_PROVIDER=bedrock

# AWS Bedrock. Leave the two key fields blank to use boto3's normal
# credential chain instead (env vars already exported in your shell,
# `aws configure`'s ~/.aws/credentials, an IAM role, SSO login, etc.) --
# only fill these in if you want the .env file itself to carry the
# credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Bedrock model ID (or cross-region inference profile ID). VERIFY this
# against your own AWS account before the event: Bedrock requires
# explicit per-model access approval (Console -> Bedrock -> Model access)
# and the exact ID string can vary by region/account -- check
# Console -> Bedrock -> Model catalog if the default below 404s on you.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Direct Anthropic API -- only read if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME
ANTHROPIC_MODEL=claude-sonnet-4-5

# App
APP_ENV=development

# --- Document ingestion (app/pipeline/ingestion) ---
# UPLOAD_DIR defaults to backend/uploads when unset.
# UPLOAD_DIR=
MAX_UPLOAD_MB=20
MAX_FILES_PER_UPLOAD=20
MAX_PDF_PAGES=200
MIN_IMAGE_SIDE_PX=300

# Docker only: load sample data when insurance-claims is empty (default
# true). Set to false to never write sample data to your cluster.
# SEED_SAMPLE_DATA=true
